# Store the finished file as SSM SecureString /todo/lab/env, never in Git.
# For Compose compatibility, use hex or base64url secrets (no dollar signs).
DB_PASSWORD=replace-with-a-long-random-password
JWT_SECRET=replace-with-at-least-32-random-bytes
DB_USER=todo
DB_URL=jdbc:postgresql://postgres:5432/todo
COOKIE_SECURE=false
ADMIN_EMAIL=admin@qq.com
ADMIN_PASSWORD=replace-with-a-strong-administrator-password
# For RDS: change DB_USER/DB_PASSWORD and DB_URL, preserving JWT_SECRET.
# DB_URL=jdbc:postgresql://YOUR-RDS-ENDPOINT:5432/todo?sslmode=verify-full&sslrootcert=/certs/global-bundle.pem
