# Copy to .env, then replace BOTH example values with independently generated secrets.
DB_PASSWORD=replace-with-a-long-random-password
JWT_SECRET=replace-with-at-least-32-random-bytes
# false is for localhost / the SSM tunnel lab ONLY; true requires trusted HTTPS.
COOKIE_SECURE=false
# Local development administrator, created only when absent.
ADMIN_EMAIL=admin@qq.com
ADMIN_PASSWORD=admin
